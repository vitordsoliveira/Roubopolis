{
  "name": "roubodopolis",
  "version": "0.1.0",
  "description": "Casca desktop do Roubodopolis. A janela abre o servidor do jogo; a lógica toda vive no Flask.",
  "author": "vitordsoliveira",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node electron/iniciar.js",
    "dev": "node electron/iniciar.js --local",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gteltestes.roubodopolis",
    "productName": "Roubodopolis",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Roubodopolis"
    }
  }
}
