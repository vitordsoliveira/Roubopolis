# Copie para .env e ajuste. O .env não vai para o git.

# --- Banco -----------------------------------------------------------
# Produção / hospedagem:
DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/banco
# Senha com caractere especial precisa de percent-encoding:
#   @ -> %40    # -> %23    : -> %3A    / -> %2F

# Desenvolvimento sem MySQL: 1 grava tudo num arquivo local e a
# DATABASE_URL acima é ignorada.
USAR_SQLITE=0
ARQUIVO_SQLITE=roubodopolis.sqlite

# --- Servidor --------------------------------------------------------
SECRET_KEY=troque-isto-em-producao
HOST=127.0.0.1
PORT=5000
DEBUG=1
